{% extends 'base.html.twig' %}

{% set title = 'trips.label'|trans %}

{% block body %}
    <div class="app-page-header">
        <twig:Typography:H1>{{ title }}</twig:Typography:H1>
        <twig:Button:New href="{{ path('app.trip.new') }}" />
    </div>

    <twig:Trip:Form:Search :form="form" />

    {% block trip_results %}
        <twig:Turbo:Frame id="{{ constant('App\\Turbo\\Frame\\TripFrameId::RESULTS') }}">
            <twig:ResultsCount :count="pager.nbResults" />

            {% if pager.nbResults > 0 %}
                <twig:Trip:IndexTable :trips="pager" />
                <twig:AppPagination :pager="pager" />
            {% endif %}
            <twig:Sticky>
                <twig:Tooltip id="trip_map_tooltip">
                    <twig:Tooltip:Trigger>
                        <twig:Button
                            as="a"
                            href="{{ path('app.trip.map', app.request.query.all) }}"
                            data-turbo-action="advance"
                            {{ ...tooltip_trigger_attrs }}
                        >
                            <twig:ux:icon name="lucide:map" />
                            {{- 'map.label'|trans -}}
                        </twig:Button>
                    </twig:Tooltip:Trigger>
                    <twig:Tooltip:Content side="top">
                        <p>{{ 'map.help'|trans }}</p>
                    </twig:Tooltip:Content>
                </twig:Tooltip>
            </twig:Sticky>
        </twig:Turbo:Frame>
    {% endblock %}
{% endblock %}
