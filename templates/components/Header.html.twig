{% set header_menu %}
    <twig:Header:Menu />
{% endset %}
{% set header_auth_buttons %}
    <twig:Header:AuthButtons />
{% endset %}

<header>
     <nav
        class="app-header-nav"
        data-controller="navbar-toggle"
        aria-label="{{ 'navigation.main.label'|trans }}"
    >
        <div class="app-header-container">
            <button
                class="app-header-toggle"
                type="button"
                data-action="click->navbar-toggle#toggle"
                data-navbar-toggle-target="toggleButton"
                aria-controls="main_mobile_navbar"
                aria-expanded="false"
                aria-label="{{ 'navigation.toggle.label'|trans }}"
            >
                <twig:ux:icon name="lucide:menu"
                    height="1.5em" width="1.5em"
                    class="hover:text-primary-foreground/80"
                    data-navbar-toggle-target="menuIcon"
                />
                <twig:ux:icon name="lucide:x"
                    height="1.5em" width="1.5em"
                    class="hover:text-primary-foreground/80 hidden"
                    data-navbar-toggle-target="closeIcon"
                />
            </button>

            <a class="app-header-brand"
                href="{{ path('app.home') }}">
                {{- 'app_name'|trans -}}
            </a>

            {# Desktop menu #}
            <div class="hidden grow md:flex">
                {{ header_menu }}
            </div>

            <div class="flex items-center">
                {% if app.user %}
                    <twig:Button as="a"
                        href="{{ path('app.logout') }}"
                        class="hidden md:inline-block hover:text-primary-foreground/80"
                        data-turbo="false"
                    >
                        {{- 'logout.label'|trans -}}
                    </twig:Button>
                     <a href="{{ path('app.user.profile.edit') }}"
                        aria-label="{{ 'user.profile.edit.label'|trans }}"
                        title="{{ 'user.profile.edit.label'|trans }}"
                    >
                        <twig:Avatar id="header_avatar"/>
                    </a>
                {% else %}
                    <div class="hidden md:inline-block">
                        {{ header_auth_buttons }}
                    </div>
                {% endif %}
            </div>

            {# Mobile menu #}
            <div
                id="main_mobile_navbar"
                class="app-header-menu"
                data-navbar-toggle-target="menu"
                aria-label="{{ 'navigation.main.label'|trans }}"
                aria-hidden="true"
                inert
            >
                {{ header_menu }}
                <div class="flex flex-col items-start mt-4">
                    {{ header_auth_buttons }}
                </div>
            </div>
        </div>
    </nav>
</header>
