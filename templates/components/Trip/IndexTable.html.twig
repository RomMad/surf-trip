{% set headers = [
    ['title.label'|trans, 't.title'],
    ['location.label'|trans, 't.location.label'],
    ['period.label'|trans, 't.startAt', 'w-32'],
    'required_levels.label'|trans,
    'description.label'|trans,
    'owners.label'|trans,
    ['published_at.label'|trans, 't.publishedAt', 'w-32'],
    'actions.label'|trans,
] %}

{% set data = trips|map(trip => [
    trip.title,
    trip.location.label,
    trip.startAt|format_datetime(pattern: ('EEE d MMM' ~ (trip.startAt|date('Y') !== trip.endAt|date('Y') ? ' yy'))) ~ ' - '
        ~ trip.endAt|format_datetime(pattern: 'EEE d MMM yy'),
    trip.requiredLevels|map(rl => rl.label|trans),
    trip.description|u.truncate(120, '…', false),
    {component: 'Trip:OwnersAvatarGroup', context: {trip: trip}},
    {component: 'Trip:Published', context: {trip: trip}},
    {component: 'Trip:IndexActionsCell', context: {trip: trip}},
    ]) %}

<twig:DataTable :headers="headers" :data="data" />
