{% if is_granted('DELETE', trip) %}
    <form method="post"
          action="{{ path('app.trip.delete', {id: trip.id}) }}"
          class="mb-4"
          onsubmit="return confirm('{{ 'trip.delete.confirm'|trans|e('js') }}');"
    >
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ trip.id) }}">
        <twig:Button:Delete />
    </form>
{% endif %}
