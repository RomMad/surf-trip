{% extends 'base.html.twig' %}

{% block body %}
    <twig:Typography:H1>{{ entity._toString ?? crud.entityLabelInSingular|trans }}</twig:Typography:H1>

    <div class="mb-4">
        {% for propertyName, item in data %}
            <div class="border-b pt-2 pb-4">
                <dt class="font-semibold">{{ item.label|trans }}</dt>
                <dd class="mt-1">{{ item.value }}</dd>
            </div>
        {% endfor %}
    </div>

    <twig:Button:Back href="{{ path(route.index) }}" />
    {% if is_granted('EDIT', entity) %}
        <twig:Button:Edit href="{{ path(route.edit, {id: entity.id }) }}" />
    {% endif %}
    {% if is_granted('DELETE', entity) %}
        <twig:FormDelete :entity="entity" :route="route" />
    {% endif %}
{% endblock %}
